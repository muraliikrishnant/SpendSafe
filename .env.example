# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible API, primary provider
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Ollama (local, free) — fallback / comparison provider
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# Which provider to try first: nvidia | ollama
LLM_PROVIDER_ORDER=nvidia,ollama

# Pipeline tuning
MAX_WORKERS=8
BATCH_SIZE=50
