# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible API, primary provider
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=openai/gpt-oss-20b
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Ollama (local, free) — fallback / comparison provider
# Local Ollama doesn't require a key by default. Only set OLLAMA_API_KEY if
# your instance is remote/behind auth (e.g. Ollama Cloud or a proxied server).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_TEXT_MODEL=gpt-oss:20b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# Which providers to query, in order: nvidia | ollama. Both are queried for
# every extraction call (see "Cross-model debate" below), not just the first.
LLM_PROVIDER_ORDER=nvidia,ollama

# Cross-model debate: when 2+ providers respond, their answers are compared;
# on disagreement beyond DEBATE_TOLERANCE_PCT, each is shown the other's
# answer for one reconsideration round before a final value is taken.
DEBATE_TOLERANCE_PCT=2

# Per-call timeout — keeps one slow/hung provider from stalling the whole run.
# Vision calls (image payloads, bigger models) get a separate, longer budget.
LLM_TIMEOUT_SECONDS=60
LLM_VISION_TIMEOUT_SECONDS=120

# Hard rate limits (sliding 1-hour window) — the pipeline BLOCKS and waits
# rather than exceeding these, so a run never gets throttled/banned by the
# provider. NVIDIA NIM free tier is commonly capped at 40 req/hour; adjust
# to your actual tier. 0 = unlimited (default for local Ollama).
NVIDIA_MAX_REQUESTS_PER_HOUR=40
OLLAMA_MAX_REQUESTS_PER_HOUR=0

# Pipeline tuning
MAX_WORKERS=8
BATCH_SIZE=50
